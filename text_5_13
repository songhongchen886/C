 //输入密码确认密码 假设密码是一个字符串
//password 在C中定义并初始化一个字符数组，用来村密码的字符串
// ={0}是初始化操作  它会把数组里每个字节都初始化为0，这样数组一开始就是空字符串，避免垃圾值影响
int main()
{
	char password[20] = { 0 };
	printf("请输入密码:");
	scanf_s("%s", password,20);
	getchar();
	printf("请确认密码:");
	char ret;
	ret= getchar();
	if (ret=='y')
	{
		printf("yes\n");
	}
	else
	{
		printf("no\n");
	}

	return 0;
}