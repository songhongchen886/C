//结构体
//char是字符类型 用来存单个字符  %s 处理字符串
struct stu
{ //结构体的成员变量
	char name[20];
	int age;
	char sex[10];
	char tele[20];
};
int main()
{
	struct stu s = {"zhangsan",20,"nv","17862775752"};
	printf("%s %d %s %s\n", s.name, s.age, s.sex, s.tele); //结构体对象.成员名
	return 0;
}